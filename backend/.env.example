# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/civic_complaints_db

# Authentication
JWT_SECRET=civic_triage_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# AI Services (For multimodal inspection & LLM classification)
# GEMINI_API_KEY=your_gemini_api_key_here
# Optional: GEMINI_MODEL=gemini-3.8-flash (defaults to gemini-3.8-flash with automatic failover)
