# ===================================================================
# CivicPulse — Environment Variables for Vercel Deployment
# ===================================================================
# Add these variables in your Vercel Project Dashboard:
# Settings -> Environment Variables
# ===================================================================

# MongoDB Connection String (Atlas URI required for cloud deployment)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/civic_complaints_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production
JWT_EXPIRES_IN=7d

# Google Gemini AI Vision Key (for multimodal auto-fill triage)
GEMINI_API_KEY=your_gemini_api_key_here

# Environment
NODE_ENV=production

# Duplicate Detection Thresholds (Optional overrides)
DUP_RADIUS_METERS=150
DUP_SIM_THRESHOLD=0.50
